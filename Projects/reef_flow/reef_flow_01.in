&ecosys_config
! Simulation period     
  Tmax = 3.0d0  ! days
! Start time
  time0 = 6577.0d0 ! day 2018/1/3

! Setting of condition (nsetting)
!
!     nSetting = 1: Stable condition
!                2: Closed chamber condition
!                3: Constant flow condition
!                4: Reef simulation condition
!                5: Incubation chamber simulation of Nakamura & Nakamori (2009) experiments
!                6: Flume simulation of Comeau et al. (2016) experiments   
  nSetting = 4

  Im = 2
  Jm = 1
  N  = 1

  dt = 1.5d0 ! Time step (sec)

  depth = 3.0d0 ! Set depth (m)

  isplitc  = 20

!** For stabilize sediment model ****
! isplitsed > 1.0d3 * sgd_flux_in * dt
!    because  Courant Number: C = v*dt/dz < 1 
!      -> sgd_flux_in*dt/isplitsed/dz_min < 1 (dz_min = 0.001 m)
  isplitsed = 2
!  isplitsed = 20  
/

&refdate
  Ryear  = 2000   ! Reference year
  Rmonth = 1      ! Reference month
  Rday   = 1      ! Reference day
/

&input_info
! frc_file(i) >= 1:  Number of input file for each parameter
! frc_file(i) =  0:  No input file (set values analytically)
!
! 1: swrad, 2: lwrad_down 3: Tair, 4: Pair, 5: wind, 
! 6: rain,  7: Relative humidity, 8: cloud
! 9: Photosynthetic photon flux density
! 10: water temp,  11: Water level 
! 12: Wave
!    
!           1       5     8 9 10  12
!           |       |     | | |   |
  in_file = 1,1,1,1,1,1,1,0,0,2,2,2
/

&input
! Both ascii text file and roms frc netcdf file (1D) are acceptable.
! *if netcdf files are used, activate INPUT_ROMS_FRC in cppdefs.h.

  SWRad_FILE = "input/Ishigaki_frc_JMAobs_2018_swrad.nc"
  LWRad_FILE = "input/Ishigaki_frc_JMAobs_2018_lwrad_down.nc"
  Tair_FILE  = "input/Ishigaki_frc_JMAobs_2018_Tair.nc"
  Pair_FILE  = "input/Ishigaki_frc_JMAobs_2018_Pair.nc"
  Wind_FILE  = "input/Ishigaki_frc_JMAobs_2018_wind.nc"
  Rain_FILE  = "input/Ishigaki_frc_JMAobs_2018_rain.nc"
  Rh_FILE    = "input/Ishigaki_frc_JMAobs_2018_Qair.nc"    ! Relative humidity (%)
  Cloud_FILE = "input/Ishigaki_frc_JMAobs_2018_cloud.nc"    ! Relative humidity (%)

! Only ascii text file is acceptable.
  PPFD_FILE  = "input/PPFD.txt"
! Only ascii text file is acceptable.
  WTEMP_FILE  = "input/temp2017.txt",
                "input/temp2018.txt"
  WLEVEL_FILE = "input/level2017.txt",
                "input/level2018.txt"
! Only ascii text file is acceptable.
  WAVE_FILE   = "input/Shiraho_wave2_201701.dat",
                "input/Shiraho_wave2_201801.dat"
/

&output   
  OUTFILE_prefix = 'test_20180103'
/

!--- Initial Condition -----------------------------------------------------
&initial

!  T0 = 28.0d0          ! Water temperature (oC)
  T0 = 23.0d0          ! Water temperature (oC)
  S0 = 34.0d0          ! Salinity (PSU)
  Sed1_0  = 0.0d0      ! Sediment concentration (g m-3)

!  pCO2air = 400.0d0   ! 383.0d0  !!! RCP8.5: 936.0d0 (uatm); RCP2.6: 421.0d0 (uatm)

  TAlk0 = 2232.0d0     ! TA  (umol kg-1)
  TIC_0 = 1915.0d0     ! DIC (umol kg-1)  !!! 2050.0d0 @ fCO2=800uatm;  2030.0d0 @ fCO2=700uatm
  Oxyg0 = 200.0d0      ! DO  (umol L-1)

  NO3_0 = 3.5d0        ! NO3 (umol L-1)
  NH4_0 = 0.26d0       ! NH4 (umol L-1)
  PO4_0 = 0.04d0       ! PO4 (umol L-1)

  DOC_0  = 5.0d0,  50.0d0                ! DOC (umolC L-1): Labile, Refractory
  POC_0  = 1.0d0,   0.0d0,  0.0d0        ! POC (umolC L-1): Labile, Refractory, Coarse
 PhyC_0  = 1.0d0,   2.0d0,  2.0d0, 0.0d0 ! PhyC (umolC L-1): Dinoflagellate, Diatom, Coccolithophorids, Cyanobacteria
 ZooC_0  = 0.1d0                         ! ZooC (umolC L-1)
  PIC_0  = 0.5d0,   0.0d0                ! PIC (umolC L-1)

  d13C_TIC0   =   0.7d0                            ! d13C_TIC (permill VPDB)
  d13C_DOC_0  = -15.0d0, -15.0d0                   ! d13C_DOC (permill VPDB)
  d13C_POC_0  = -15.0d0, -15.0d0, -15.0d0          ! d13C_POC (permill VPDB)
  d13C_PhyC_0 = -15.0d0, -15.0d0, -15.0d0, -15.0d0 ! d13C_PhyC (permill VPDB)
  d13C_ZooC_0 = -20.0d0                            ! d13C_ZooC (permill VPDB)
  d13C_PIC_0  =  -5.0d0,  -5.0d0                   ! d13C_PIC (permill VPDB)

  d15N_NO3_0  =   0.7d0                            ! d15N_NO3 (permill AIR)
  d15N_NH4_0  =   0.7d0                            ! d15N_NH4 (permill AIR)
  d15N_DON_0  = -15.0d0, -15.0d0                   ! d15N_DON (permill AIR)
  d15N_PON_0  = -15.0d0, -15.0d0, -15.0d0          ! d15N_PON (permill AIR)
  d15N_PhyN_0 = -15.0d0, -15.0d0, -15.0d0, -15.0d0 ! d15N_PhyN (permill AIR)
  d15N_ZooN_0 = -20.0d0                            ! d15N_ZooN (permill AIR)

  p_coral_0  = 0.2d0, 0.2d0  ! Coral coverage (Ncl)
  p_algae_0  = 0.0d0         ! Algal coverage (Nag)
  p_sgrass_0 = 0.0d0         ! Seagrass coverage (Nsg)
  p_sand_0   = 0.0d0         ! Sand coverage
/

!--- Sediment ecosystem model ----------------------------------------------
&sedeco_config

  Fdep_sed_in  = 3.0d-8  ! Sedimentation rate (g cm-2 s-1); 2.77d-8 g/cm2/s = 1.0 g/m2/h
                         ! (Positive: sedimentation; Negative: erosion)
  MnO2_sed_in  = 1.0d2   ! Manganese oxide (MnO2) concentration in sediments [nmol/g(DW)]
  FeOOH_sed_in = 1.0d3   ! Iron hydroxide (FeOOH) concentration in sediments [nmol/g(DW)]
  FeS2_sed_in  = 1.0d3   ! Iron sulfide (FeS2) concentration in sediments [nmol/g(DW)]
  rCaCO3_sed_in = 0.2d0  ! CaCO3 volume ratio in sediments [no dim.]
  LPOC_sed_in  = 1.0d1   ! Labile Organic carbon in sediments [nmol/g(DW)]
  RPOC_sed_in  = 1.0d4   ! Refractory Organic carbon in sediments [nmol/g(DW)]

  sgd_flux_in = 0.0d0    ! Submarine groundwater discharge rate (cm s-1)
  sgd_Tmp_in  = 23.0d0   ! SGD: Temperature (oC)
  sgd_Sal_in  = 34.0d0   ! SGD: Salinity (PSU)
  sgd_DOx_in  = 200.0d0  ! SGD: DO  (umol L-1)
  sgd_TA_in   = 2232.0d0 ! SGD: TA  (umol kg-1)
  sgd_DIC_in  = 1915.0d0 ! SGD: DIC (umol kg-1)
  sgd_NO3_in  = 3.5d0    ! SGD: NO3 (umol L-1)
  sgd_NH4_in  = 0.26d0   ! SGD: NH4 (umol L-1)
  sgd_PO4_in  = 0.04d0   ! SGD: PO4 (umol L-1)
  sgd_DOC_in  = 5.0d0,  50.0d0  ! SGD: DOC (umolC L-1): Labile, Refractory
  sgd_DON_in  = 1.0d0,  10.0d0  ! SGD: DON (umolN L-1): Labile, Refractory
  sgd_DOP_in  = 0.06d0,  0.6d0  ! SGD: DOP (umolP L-1): Labile, Refractory
/

!--- Seagrass model --------------------------------------------------------
&sgrass_config
  XI_size_in  = 50.0d0 ! (m)
  ETA_size_in = 50.0d0 ! (m)
/
